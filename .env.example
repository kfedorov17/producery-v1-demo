# Producery — copy to .env. The application reads its values through pydantic-settings (producery/settings.py);
# BASE_REGISTRY and IMAGE_TAG are read by compose, SESSION_SECRET / COOKIE_SECURE / LANGSMITH_*_ID by the web UI.
# docker-compose.yml lists per service which of these variables it passes. Kubernetes: ConfigMap + Secret, same names.

# --- Identity ---------------------------------------------------------------
# REVISION_ID is baked into the images at build time (git sha) and must NOT be set here (it would override it).
PRODUCERY_ENV=local                 # local | ci | prod | test
AGENCY_ID=lakeview                  # demo agency namespace (memory + proposals)

# --- Agent API (every route except /health and /ready requires this bearer token) -------------------
# REQUIRED: the agent refuses to start when empty. `make setup` (or `make token`) generates one; CI sets it from a secret.
AGENT_API_TOKEN=

# --- LangSmith (operational backbone) --------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=                  # workspace-scoped service key
LANGSMITH_PROJECT=producery
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_MASK_PII=true              # traces: e-mail local parts, phone numbers, SSNs and sender names are redacted client-side

# --- Model access door ------------------------------------------------------
# gateway   : LangSmith LLM Gateway is the single door (design target). Needs the org flag llm_gateway_enabled.
# langchain : interim door — LangChain-native init_chat_model(...).with_fallbacks(...) driven by config/models.yaml.
#             Requires provider keys below. Chosen only by explicit decision (see docs/design.md §9).
MODEL_ACCESS_MODE=gateway
LANGSMITH_GATEWAY_BASE_URL=https://gateway.smith.langchain.com/v1
# Interim option 3 (flagged): run `python bridge/claude_cli_bridge.py` on the host and point the door at it:
#MODEL_ACCESS_MODE=langchain
#LANGSMITH_GATEWAY_BASE_URL=http://host.docker.internal:8099/v1
#MODEL_DOOR_LABEL=claude-cli-bridge (interim, option 3)
MODEL_DOOR_LABEL=gateway
# Interim door only:
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#GOOGLE_API_KEY=

# --- Prompt Hub -------------------------------------------------------------
PROMPTS_SOURCE=hub                  # hub (pinned pulls) | local (tests and prompts_push only)
PROMPT_HUB_PREFIX=producery         # Hub prompt names: <prefix>-<agent>
PROMPTS_LOCAL_FALLBACK=true         # Hub unreachable at startup: serve prompts/<name>.yaml only when its fingerprint equals the pin

# --- Images ----------------------------------------------------------------
# Where the library base images (python, node, redis) are pulled from: the Docker Hub mirror on ECR Public by
# default (no anonymous pull limit); point it at a private pull-through mirror in production.
BASE_REGISTRY=public.ecr.aws/docker/library
# IMAGE_TAG names the images compose runs. `local` = the from-source build of the quickstart. scripts/pipeline.py deploy
# rewrites this line to the promoted tag so a later bare `docker compose up -d <service>` cannot fall back to another image.
IMAGE_TAG=local

# --- Producer web UI (docs/design.md §14; the `web` compose service, http://localhost:3010) -------------------
# SESSION_SECRET signs the producer's session cookie: 32+ random characters (`make token` fills it when empty).
SESSION_SECRET=
COOKIE_SECURE=0                     # 1 behind TLS; the local stack is plain http
# Optional: lets Thread screens deep-link to LangSmith traces (Settings → workspace ids).
LANGSMITH_ORG_ID=
LANGSMITH_PROJECT_ID=

# --- Stores -----------------------------------------------------------------
DATABASE_URL=postgresql://producery:producery@postgres:5432/producery
DATABASE_READONLY_ROLE=producery_readonly
REDIS_URL=redis://redis:6379/0

# --- Service mesh (compose DNS now; k8s Services later) ---------------------
AGENT_URL=http://agent:8000
MCP_DATA_URL=http://mcp-data:8081/mcp
MCP_EXEC_URL=http://mcp-exec:8082/mcp
EXECUTOR_URL=http://executor:9000

# --- Code executor behind run_code --------------------------------------------
CODE_EXECUTOR=sealed                # sealed (compose executor) | langsmith (LangSmith Sandboxes, when entitled)

# --- Evaluation harness (host side; defaults match the compose host ports) ----
EVAL_AGENT_URL=http://localhost:8010
EVAL_MCP_DATA_URL=http://localhost:8091/mcp
EVAL_MCP_EXEC_URL=http://localhost:8092/mcp
EVAL_THREAD_CLASS=eval
EVAL_RESULTS_DIR=.eval-results
# scripts/demo.py reaches Postgres from the host through DATABASE_URL_LOCAL (default postgresql://producery:producery@localhost:5444/producery)

# --- Embeddings (local, deterministic, pinned) ------------------------------
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIMS=384
FASTEMBED_CACHE=/opt/fastembed

# --- Budgets and timeouts ---------------------------------------------------
MODEL_TIMEOUT_S=90
MCP_TIMEOUT_S=30
EXEC_MAX_TIMEOUT_S=60
TURN_TIMEOUT_S=240
